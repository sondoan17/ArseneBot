# Discord Bot Token (required)
DISCORD_TOKEN=

# Discord Application Client ID (required)
DISCORD_CLIENT_ID=

# Discord Guild ID (optional, for dev: deploy commands to single guild for instant update)
DISCORD_GUILD_ID=

# YouTube Cookie (optional)
# Dùng khi gặp lỗi "Sign in to confirm you're not a bot"
# Cách lấy: mở YouTube trên Chrome > DevTools > Application > Cookies
# Copy tất cả cookies dạng: name1=value1; name2=value2
# WARNING: Không share file này cho ai!
YOUTUBE_COOKIE=

# Log Level: info | warn | error
LOG_LEVEL=info
